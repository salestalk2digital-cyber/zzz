rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sales.talk2digital@gmail.com' ||
        request.auth.token.email == 'owner@supremeads.com'
      );
    }

    // Health / Connection check doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection (profiles & credentials)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Leads and nested remarks
    match /leads/{leadId} {
      allow read, write: if true;

      match /remarks/{remarkId} {
        allow read, write: if true;
      }
    }

    // Follow-up Queue Tasks
    match /followUpTasks/{taskId} {
      allow read, write: if true;
    }

    // Slot Bookings & Inquiries
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Proposals
    match /proposals/{proposalId} {
      allow read, write: if true;
    }

    // Meetings
    match /meetings/{meetingId} {
      allow read, write: if true;
    }

    // Notifications & Escalations
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Outlet / System settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
